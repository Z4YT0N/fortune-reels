     // Reuse an open Flow tab if there is one (CDP mode), else open our own.
-    const existing = this.context.pages().find((p) => p.url().startsWith(FLOW_ORIGIN));
+    // FLOW_TAB_SLOT=N: use the N-th Flow tab (own tab per parallel caller); open it if missing.
+    const slot = Number(process.env.FLOW_TAB_SLOT || 0);
+    const flowTabs = this.context.pages().filter((p) => p.url().startsWith(FLOW_ORIGIN) && !p.url().includes('fd=1')); // fd=1: flow-direct's own tab
+    const existing = flowTabs[slot];
     const page = existing ?? (await this.context.newPage());
     if (!existing) await page.goto(FLOW_ORIGIN + '/', { waitUntil: 'domcontentloaded' });
     page.on('close', () => { if (this.page === page) this.page = undefined; });
