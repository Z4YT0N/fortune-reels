+  /** Upload local image/video files through the ingredient picker's "Upload media" (real file chooser). */
+  async uploadFiles(paths: string[]) {
+    const c = await this.tagComposer();
+    await c.locator('button[aria-label="Add ingredients to the prompt box"]').click();
+    const up = this.page.getByRole('button', { name: 'Upload media' }).first();
+    await up.waitFor({ state: 'visible', timeout: 10_000 });
+    const [fc] = await Promise.all([this.page.waitForEvent('filechooser', { timeout: 15_000 }), up.click()]);
+    await fc.setFiles(paths);
+    const agree = this.page.getByRole('button', { name: 'I agree' }).first();
+    await agree.waitFor({ state: 'visible', timeout: 6_000 }).then(() => agree.click()).catch(() => {});
+    await this.page.waitForTimeout(1500);
+    await this.page.keyboard.press('Escape').catch(() => {});
+  }
+
+  /** Send the agent message without depending on reading the streamed response body. */
+  async sendAgentMessage() {
+    await this.generateButton().click();
+    await this.page.waitForTimeout(1500);
+  }
+
+  /**
+   * Wait for the agent to finish its turn. Returns the newest credit quote if a fresh,
+   * enabled "Approve" radio is waiting, else undefined (no approval needed).
+   */
+  async waitForAgentQuote(timeoutMs = 90_000): Promise<number | undefined> {
+    const deadline = Date.now() + timeoutMs;
+    while (Date.now() < deadline) {
+      const q = await this.page.evaluate(() => {
+        const radios = [...document.querySelectorAll<HTMLElement>('[role=radio]')].filter((r) => /Approve/.test(r.innerText || r.getAttribute('aria-label') || '') && !(r as any).disabled && r.getAttribute('aria-disabled') !== 'true' && r.offsetParent);
+        const live = radios.filter((r) => !(r.querySelector('input') as HTMLInputElement | null)?.disabled);
+        if (!live.length) return null;
+        let n: HTMLElement | null = live[live.length - 1];
+        for (let i = 0; i < 8 && n; i++) {
+          const m = (n.innerText || '').match(/costing\s+([\d,]+)\s+credits?/i);
+          if (m) return Number(m[1].replace(/,/g, ''));
+          n = n.parentElement;
+        }
+        return -1;
+      });
+      if (q !== null) return q;
+      // agent finished without asking (images): the send button is enabled again and the input is empty
+      const idle = await this.page.evaluate(() => !!document.querySelector('button[aria-label="Start generation"]:not([disabled])'));
+      if (idle && Date.now() > deadline - timeoutMs + 20_000) return undefined;
+      await this.page.waitForTimeout(2000);
+    }
+    return undefined;
+  }
+
+  async clickLatestApprove() {
+    const r = this.page.getByRole('radio', { name: 'Approve', exact: true }).last();
+    await r.click();
+    await this.page.waitForTimeout(2000);
+  }
+
   async startNewAgentSession() {
     const btn = this.page.locator('button:has(mat-icon:text-is("edit_square")):visible').first();
     if (await btn.count()) { await btn.click(); await this.page.waitForTimeout(800); }
