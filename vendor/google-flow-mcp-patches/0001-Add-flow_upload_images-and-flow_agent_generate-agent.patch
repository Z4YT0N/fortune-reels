+  /** Upload local files; returns the new media id per path (matched by file name = Flow caption). */
+  async uploadImages(projectId: string, paths: string[]) {
+    const base = (p: string) => p.split(/[\\/]/).pop()!;
+    const before = new Set((await this.contents(projectId)).workflows.map((w: any) => w.mediaId));
+    await this.withUi(async (ui) => { await ui.openProject(projectId); await ui.setMode('agent'); await ui.uploadFiles(paths); });
+    const deadline = Date.now() + 180_000;
+    let found: { path: string; mediaId?: string }[] = paths.map((p) => ({ path: p }));
+    while (Date.now() < deadline) {
+      const ws = (await this.contents(projectId)).workflows.filter((w: any) => !before.has(w.mediaId));
+      found = paths.map((p) => ({ path: p, mediaId: ws.find((w: any) => w.caption === base(p))?.mediaId }));
+      if (found.every((f) => f.mediaId)) break;
+      await sleep(4000);
+    }
+    return { uploads: found, missing: found.filter((f) => !f.mediaId).map((f) => f.path) };
+  }
+
+  /**
+   * One-call generation through the agent panel (works while the manual composer settings are hidden).
+   * image: Nano Banana Pro. video: Omni (frames-to-video when start+end ids are given).
+   * Auto-approves only when Flow's quote <= maxCredits; optionally waits and downloads.
+   */
+  async agentGenerate(o: {
+    projectId: string; kind: 'image' | 'video'; prompt: string; aspect: string; count: number;
+    referenceImageIds?: string[]; startImageId?: string; endImageId?: string;
+    model?: string; durationSec?: number; resolution?: string; maxCredits: number; wait: boolean;
+    downloadDir?: string; download: (mediaId: string, dir?: string) => Promise<string>;
+  }) {
+    const before = new Set((await this.contents(o.projectId)).workflows.map((w: any) => w.mediaId));
+    let msg: string; let imageIds: string[] = [];
+    if (o.kind === 'image') {
+      imageIds = o.referenceImageIds ?? [];
+      msg = `Generate ${o.count} image${o.count > 1 ? 's' : ''} now with Nano Banana Pro, ${o.aspect}, x${o.count}. Do not generate video. ` +
+        (imageIds.length ? 'Use the attached image(s) as references for subject and style. ' : '') + `Image: ${o.prompt}`;
+    } else {
+      const model = o.model ?? 'Omni 1.2 Flash'; const dur = o.durationSec ?? 4; const res = o.resolution ?? '720p';
+      if (o.startImageId && o.endImageId) {
+        imageIds = [o.startImageId, o.endImageId];
+        msg = `Generate ONE video now with ${model}, frames-to-video mode, ${o.aspect}, ${dur} seconds, ${res}, x1. Use the first attached image as the FIRST frame and the second attached image as the LAST frame. Do not generate images. ${o.prompt}`;
+      } else if (o.startImageId) {
+        imageIds = [o.startImageId];
+        msg = `Generate ONE video now with ${model}, image-to-video mode, ${o.aspect}, ${dur} seconds, ${res}, x1. Use the attached image as the FIRST frame. Do not generate images. ${o.prompt}`;
+      } else {
+        imageIds = o.referenceImageIds ?? [];
+        msg = `Generate ONE video now with ${model}, ${o.aspect}, ${dur} seconds, ${res}, x1. ` + (imageIds.length ? 'Use the attached images as ingredients. ' : '') + `Do not generate images. ${o.prompt}`;
+      }
+    }
+    const chat = await this.agentChat({ projectId: o.projectId, message: msg, newSession: true, imageIds, maxCredits: o.maxCredits });
+    let ids: string[] = chat.generatedMediaIds;
+    if (!ids.length) {
+      const deadline = Date.now() + (o.kind === 'image' ? 120_000 : 60_000);
+      while (Date.now() < deadline) {
+        ids = (await this.contents(o.projectId)).workflows.filter((w: any) => !before.has(w.mediaId)).map((w: any) => w.mediaId);
+        if (ids.length) break;
+        await sleep(4000);
+      }
+    }
+    let videoStatus: any;
+    if (o.kind === 'video' && o.wait && ids.length) videoStatus = await this.waitForVideos(ids);
+    const files: string[] = [];
+    if (o.downloadDir && ids.length && (o.kind === 'image' || o.wait)) {
+      for (const id of ids) files.push(await o.download(id, o.downloadDir).catch((e) => `ERROR ${e}`));
+    }
+    return { mediaIds: ids, files, approval: chat.approval, pendingPermission: chat.pendingPermission, reply: chat.reply, videoStatus };
+  }
